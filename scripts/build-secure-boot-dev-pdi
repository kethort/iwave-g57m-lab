#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_NAME="$(basename "$0")"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
LAB_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd)"

FIRMWARE_ROOT=""
WORKSPACE=""
OUT_DIR="${LAB_ROOT}/secure-boot-private/dev-auth"
BASE_PDI=""
PLM_ELF=""
RPU_ELF=""
AUTH_ALGORITHM="rsa"
FORCE_KEYS=0
VERIFY_IMAGE=1

info()  { printf '[INFO] %s\n' "$*"; }
error() { printf '[ERROR] %s\n' "$*" >&2; exit 1; }

usage()
{
	cat <<EOF_USAGE
Usage:
  ${SCRIPT_NAME} --firmware-root <repo> [options]

Build a reversible, no-eFUSE secure-boot development PDI for the PLM/RPU lab
firmware. Private keys, BIFs, generated PDIs, and logs are written under
secure-boot-private/ by default and are ignored by Git.

Required:
  --firmware-root <repo>  Checkout containing plm/build, plm/src, and plm/rpu-app.

Options:
  --workspace <dir>       Vitis workspace. Default: <firmware-root>/plm/build
  --base-pdi <file>       Base hardware PDI to reuse.
                          Default: <workspace>/platform/hw/sdt/system.pdi
  --plm-elf <file>        Custom PLM ELF.
                          Default: <workspace>/plm/build/plm.elf
  --rpu-elf <file>        RPU ELF.
                          Default: <workspace>/rpu_ipi_ping_pong/build/rpu_ipi_ping_pong.elf
  --out-dir <dir>         Private output directory.
                          Default: ./secure-boot-private/dev-auth
  --auth <algorithm>      rsa, ecdsa-p384, or ecdsa-p521. Default: rsa
  --force-keys            Regenerate development signing keys.
  --no-verify             Skip bootgen -verify.
  -h, --help              Show this help.

This script does not program QSPI, JTAG, BBRAM, or eFUSEs. It only creates and
verifies a Bootgen-authenticated development PDI.
EOF_USAGE
}

require_command()
{
	command -v "$1" >/dev/null 2>&1 || error "required command not found in PATH: $1"
}

resolve_dir()
{
	local path="$1"
	[[ -d "${path}" ]] || error "directory not found: ${path}"
	realpath -- "${path}"
}

resolve_existing_file()
{
	local path="$1"
	local label="$2"
	[[ -f "${path}" ]] || error "${label} not found: ${path}"
	realpath -- "${path}"
}

keygen_argument()
{
	case "$1" in
		rsa) printf 'pem' ;;
		ecdsa-p384) printf 'ecdsa-p384' ;;
		ecdsa-p521) printf 'ecdsa-p521' ;;
		*) error "unsupported --auth value: $1" ;;
	esac
}

parse_args()
{
	while (($#)); do
		case "$1" in
			--firmware-root)
				(($# >= 2)) || error "--firmware-root requires a value"
				FIRMWARE_ROOT="$2"
				shift 2
				;;
			--workspace)
				(($# >= 2)) || error "--workspace requires a value"
				WORKSPACE="$2"
				shift 2
				;;
			--base-pdi)
				(($# >= 2)) || error "--base-pdi requires a value"
				BASE_PDI="$2"
				shift 2
				;;
			--plm-elf)
				(($# >= 2)) || error "--plm-elf requires a value"
				PLM_ELF="$2"
				shift 2
				;;
			--rpu-elf)
				(($# >= 2)) || error "--rpu-elf requires a value"
				RPU_ELF="$2"
				shift 2
				;;
			--out-dir)
				(($# >= 2)) || error "--out-dir requires a value"
				OUT_DIR="$2"
				shift 2
				;;
			--auth)
				(($# >= 2)) || error "--auth requires a value"
				AUTH_ALGORITHM="$2"
				shift 2
				;;
			--force-keys)
				FORCE_KEYS=1
				shift
				;;
			--no-verify)
				VERIFY_IMAGE=0
				shift
				;;
			-h|--help)
				usage
				exit 0
				;;
			*)
				error "unknown argument: $1"
				;;
		esac
	done
}

write_keygen_bif()
{
	local keygen_bif="$1"
	local psk_file="$2"
	local ssk_file="$3"

	cat >"${keygen_bif}" <<EOF_BIF
dev_keys:
{
    pskfile = "${psk_file}"
    sskfile = "${ssk_file}"
}
EOF_BIF
}

write_secure_bif()
{
	local output_bif="$1"
	local psk_file="$2"
	local ssk_file="$3"

	cat >"${output_bif}" <<EOF_BIF
secure_dev:
{
    boot_config { bh_auth_enable }
    pskfile = "${psk_file}"
    sskfile = "${ssk_file}"

    image
    {
        name = pmc_subsys
        id = 0x1C000001

        partition
        {
            type = bootloader
            authentication = ${AUTH_ALGORITHM}
            file = "${PLM_ELF}"
        }

        partition
        {
            type = bootimage
            file = "${BASE_PDI}"
        }
    }

    image
    {
        name = def_subsystem
        id = 0x1C000000

        partition
        {
            core = r5-0
            authentication = ${AUTH_ALGORITHM}
            file = "${RPU_ELF}"
        }
    }
}
EOF_BIF
}

main()
{
	parse_args "$@"
	require_command bootgen
	require_command realpath

	[[ -n "${FIRMWARE_ROOT}" ]] || error "--firmware-root is required"
	FIRMWARE_ROOT="$(resolve_dir "${FIRMWARE_ROOT}")"
	WORKSPACE="${WORKSPACE:-${FIRMWARE_ROOT}/plm/build}"
	WORKSPACE="$(resolve_dir "${WORKSPACE}")"

	local keygen_arg
	keygen_arg="$(keygen_argument "${AUTH_ALGORITHM}")"

	mkdir -p -- "${OUT_DIR}"
	OUT_DIR="$(realpath -- "${OUT_DIR}")"

	BASE_PDI="${BASE_PDI:-${WORKSPACE}/platform/hw/sdt/system.pdi}"
	PLM_ELF="${PLM_ELF:-${WORKSPACE}/plm/build/plm.elf}"
	RPU_ELF="${RPU_ELF:-${WORKSPACE}/rpu_ipi_ping_pong/build/rpu_ipi_ping_pong.elf}"

	BASE_PDI="$(resolve_existing_file "${BASE_PDI}" "base PDI")"
	PLM_ELF="$(resolve_existing_file "${PLM_ELF}" "PLM ELF")"
	RPU_ELF="$(resolve_existing_file "${RPU_ELF}" "RPU ELF")"

	local key_dir="${OUT_DIR}/keys"
	local psk_file="${key_dir}/primary.pem"
	local ssk_file="${key_dir}/secondary.pem"
	local keygen_bif="${OUT_DIR}/dev-keys.bif"
	local secure_bif="${OUT_DIR}/secure-dev-pdi.bif"
	local output_pdi="${OUT_DIR}/SECURE_DEV_PLM_RPU_JTAG.pdi"
	local read_log="${OUT_DIR}/SECURE_DEV_PLM_RPU_JTAG.read.txt"
	local verify_log="${OUT_DIR}/SECURE_DEV_PLM_RPU_JTAG.verify.txt"

	mkdir -p -- "${key_dir}"
	chmod 700 "${key_dir}" || true

	info "Firmware : ${FIRMWARE_ROOT}"
	info "Base PDI : ${BASE_PDI}"
	info "PLM ELF  : ${PLM_ELF}"
	info "RPU ELF  : ${RPU_ELF}"
	info "Output   : ${output_pdi}"
	info "Auth     : ${AUTH_ALGORITHM}"

	write_keygen_bif "${keygen_bif}" "${psk_file}" "${ssk_file}"

	if [[ "${FORCE_KEYS}" == "1" || ! -f "${psk_file}" || ! -f "${ssk_file}" ]]; then
		info "Generating development signing keys in ${key_dir}"
		bootgen -arch versal -image "${keygen_bif}" -generate_keys "${keygen_arg}"
		chmod 600 "${psk_file}" "${ssk_file}" || true
	else
		info "Reusing existing development signing keys in ${key_dir}"
	fi

	write_secure_bif "${secure_bif}" "${psk_file}" "${ssk_file}"

	info "Building authenticated development PDI"
	bootgen -arch versal -image "${secure_bif}" -w -o "${output_pdi}"

	info "Writing Bootgen readback log"
	bootgen -arch versal -read "${output_pdi}" >"${read_log}"

	if [[ "${VERIFY_IMAGE}" == "1" ]]; then
		info "Verifying authentication certificates"
		bootgen -arch versal -verify "${output_pdi}" | tee "${verify_log}"
	fi

	cat <<EOF_DONE

[DONE] Secure-boot development artifacts:
  PDI        : ${output_pdi}
  BIF        : ${secure_bif}
  read log   : ${read_log}
  verify log : ${verify_log}
  keys       : ${key_dir}

This is a no-eFUSE development image. It exercises Bootgen authentication
packaging and verification, but it does not place the board into an enforced
hardware-root-of-trust production state.
EOF_DONE
}

main "$@"
