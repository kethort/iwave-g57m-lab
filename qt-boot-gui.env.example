# Copy this file to qt-boot-gui.env and adjust it for one host.
# Explicit shell environment variables override values in that file.

VITIS_SETTINGS=/opt/amd/2025.2/Vitis/settings64.sh
WORKSPACE=${HOME}/versal-lab-data
TFTP_ROOT=/srv/tftp

# Leave IMAGE_NAME unset to prefer a locally built image and otherwise use GHCR.
# IMAGE_NAME=ghcr.io/kethort/iwave-g57m-lab:latest

AUTO_START_HW_SERVER=1
HW_SERVER_URL=TCP:127.0.0.1:3121
ALLOW_IMAGE_PULL=1

# Startup configurations use container-visible paths.
QT_BOOT_GUI_JTAG_CONFIG=/work/configs/jtag_config.json
QT_BOOT_GUI_QSPI_CONFIG=/work/configs/qspi_config.json
